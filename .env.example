# ---- Buyer (the gateway pays with this wallet) -------------------------------
# 25-word Algorand mnemonic, or a base64 secret key. Needs testnet ALGO + USDC.
# Reusing an already-funded wallet from a previous project is the fastest path.
FACET_BUYER_PRIVATE_KEY=""

# ---- Payees (one per role in the asset's supply chain) -----------------------
# Each must be opted in to testnet USDC (ASA 10458941) to receive payment.
FACET_MODELLER_ADDRESS=
FACET_MATERIAL_ADDRESS=
FACET_RIGHTS_ADDRESS=

# ---- Infrastructure ----------------------------------------------------------
FACILITATOR_URL=https://facilitator.goplausible.xyz
ASSET_SERVER_URL=http://localhost:4030
ASSET_SERVER_PORT=4030
PORT=4020

# ---- Local development aids (leave unset in any deployment) ------------------
# PREVIEW_TIER makes the FREE preview endpoint serve a paid tier, and
# PREVIEW_MATERIAL adds the PBR material to it, so you can iterate on the viewer
# without spending testnet funds on every reload. Both give away paid fidelity.
# PREVIEW_TIER=2
# PREVIEW_MATERIAL=1
