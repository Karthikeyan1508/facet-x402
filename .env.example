# =============================================================================
#  Facet — environment configuration
#  Generate all of these with:  npm run wallets
# =============================================================================

# ---- Buyer: the wallet that PAYS for every unlock ---------------------------
# 25-word Algorand mnemonic (or a base64 secret key).
# Needs testnet ALGO *and* testnet USDC.
# KEEP THE BALANCE SMALL. /api/unlock is public and unauthenticated by design,
# so this balance is the real cap on what a stranger can spend.
FACET_BUYER_PRIVATE_KEY=""

# ---- Payees: the wallets that GET PAID --------------------------------------
# The app only ever needs the addresses at runtime.
FACET_MODELLER_ADDRESS=
FACET_MATERIAL_ADDRESS=
FACET_RIGHTS_ADDRESS=

# The mnemonics are needed ONCE, by `npm run optin`, because on Algorand an
# account must sign its own opt-in before it can receive USDC. After opt-in you
# can delete these lines — and do NOT add them to Vercel.
FACET_MODELLER_MNEMONIC=""
FACET_MATERIAL_MNEMONIC=""
FACET_RIGHTS_MNEMONIC=""

# ---- Network ----------------------------------------------------------------
FACILITATOR_URL=https://facilitator.goplausible.xyz
# Algorand node used by the wallet scripts (not by the app itself).
ALGOD_URL=https://testnet-api.algonode.cloud
# ALGOD_TOKEN=
# Testnet USDC. Do not change unless you know why.
USDC_ASA_ID=10458941

# ---- Optional ----------------------------------------------------------------
# Unlocks allowed per minute per warm instance (default 15).
MAX_UNLOCKS_PER_MINUTE=15
# Only set if the seller lives somewhere other than this same deployment.
# ASSET_SERVER_URL=
# Local dev port. Vercel ignores this.
PORT=4020

# ---- Local development aids (never set these in a deployment) ----------------
# Serve paid fidelity from the FREE endpoint so you can iterate on the viewer
# without spending testnet funds on every reload.
# PREVIEW_TIER=2
# PREVIEW_MATERIAL=1
